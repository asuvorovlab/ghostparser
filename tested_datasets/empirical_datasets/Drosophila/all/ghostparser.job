#!/bin/sh

#SBATCH --time=24:00:00   # walltime
#SBATCH --ntasks=24   # number of processor cores (i.e. tasks)
#SBATCH --nodes=1   # number of nodes
#SBATCH --mem-per-cpu=5000M # memory per CPU core
#SBATCH -J "ghostparser"   # job name
#SBATCH --mail-user=ethan.tolman@gmail.com   # email address
#SBATCH --account=asuvorov
#SBATCH --partition=normal_q
#SBATCH --mail-type=BEGIN
#SBATCH --mail-type=END
#SBATCH --mail-type=FAIL

# Set the max number of threads to use for programs using OpenMP. Should be <= ppn. Does nothing if the program doesn't use OpenMP.

# LOAD MODULES, INSERT CODE, AND RUN YOUR PROGRAMS HERE

source ~/.bashrc
conda activate ghostbuster_env
python ~/ghostparser_final/bin/ghostparser.py --out_taxa Out.txt --input_trees ../drosophila.trees --species_tree ../species.tree --output_file ghostparser_output.txt --threads 24

