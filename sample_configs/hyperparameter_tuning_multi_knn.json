{
  "input_path": "./results/summary_statistics.tsv",
  "output_dir": "./results/hyper_tune_knn_out",
  "target_column": "class",
  "test_size": 0.2,
  "cv_folds": 5,
  "rare_class_policy": "warn_reduce_cv",
  "seed": 42,
  "n_jobs": -1,

  "hyperparameter_tuning": {
    "model": "multi_knn",
    "method": "random",
    "objective": "macro_f1",
    "top_k": 5,
    "n_iter": 20,
    "max_candidates": 5000,
    "use_wandb": false,

    "search_space": {
      "n_neighbors": [3, 5, 9, 15],
      "weights": ["uniform", "distance"],
      "algorithm": ["auto"],
      "leaf_size": [20, 30, 50],
      "metric": ["minkowski"],
      "p": [1, 2]
    }
  }
}
